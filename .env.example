# =========================================================================
# TopoSphere / NexaLab Environment Configuration
# =========================================================================

# Neon PostgreSQL Serverless Connection String
# Get this from your Neon project dashboard: https://console.neon.tech
# Example: postgresql://username:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
VITE_NEON_DATABASE_URL=

# Super Admin Password Override (Optional, defaults to superadminsecret2026)
VITE_ADMIN_PASSWORD="superadminsecret2026"

# Automated Email Delivery (Optional)
# Get a 100% free access key from https://web3forms.com (takes 10 seconds, no credit card)
# Or a free Resend API key from https://resend.com
VITE_WEB3FORMS_ACCESS_KEY=
VITE_RESEND_API_KEY=

# App Environment
VITE_APP_NAME="TopoSphere"

